{
  "name": "spendct",
  "version": "0.1.0",
  "private": true,
  "description": "消费CT · SpendCT —— AI账单体检与消费洞察平台（传智杯 AI WEB 赛道，方向 8）",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/tsgo/lib/tsc.js --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:duckdb": "node scripts/sync-duckdb-wasm.mjs",
    "postinstall": "node scripts/sync-duckdb-wasm.mjs",
    "check-secrets": "bash scripts/check-secrets.sh"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.63",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/react": "4.0.140",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@huggingface/transformers": "4.3.1",
    "@tanstack/react-query": "5.104.2",
    "ai": "7.0.137",
    "apache-arrow": "21.2.0",
    "echarts": "6.1.0",
    "framer-motion": "14.1.0",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.25.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsgo": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
